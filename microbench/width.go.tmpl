// Streaming rows over slices of n money values: 8*n or 16*n bytes each.
func benchMemW(b *testing.B, n int) {
	a, c := make([]DW, n), make([]DW, n)
	q := make([]DW, n)
	for i := range a {
		a[i] = moneyW[i&7]
		q[i] = ratesW[(i*5)&7]
	}
	tag := fmt.Sprintf("/W/n=%d", n)
	b.Run("Sum"+tag, func(b *testing.B) {
		b.SetBytes(int64(n) * W / 8)
		var s DW
		for range b.N {
			s = 0
			for _, v := range a {
				s += v
			}
		}
		sinkW = s
	})
	b.Run("MulQuant"+tag, func(b *testing.B) {
		b.SetBytes(3 * int64(n) * W / 8)
		for range b.N {
			for i := range a {
				c[i] = decimal.Quantize(a[i]*q[i], centW)
			}
		}
	})
	b.Run("Max"+tag, func(b *testing.B) {
		b.SetBytes(int64(n) * W / 8)
		var s DW
		for range b.N {
			s = a[0]
			for _, v := range a {
				if v > s {
					s = v
				}
			}
		}
		sinkW = s
	})
}

// Sort of n d16 values (copy restored each iteration, time includes copy).
func benchSortW(b *testing.B, n int) {
	xs, _ := poolW(n, 7)
	w := make([]DW, n)
	b.Run(fmt.Sprintf("Sort/W/n=%d", n), func(b *testing.B) {
		for range b.N {
			copy(w, xs)
			slices.SortFunc(w, func(x, y DW) int {
				if x < y {
					return -1
				}
				if x > y {
					return 1
				}
				return 0
			})
		}
	})
}

// Gather: sum of table[idx[i]] for 1M random indices into a table of n values,
// so the table's footprint (8*n or 16*n bytes) decides which cache level holds it.
func benchGatherW(b *testing.B, n int, idx []int32) {
	t := make([]DW, n)
	for i := range t {
		t[i] = moneyW[i&7]
	}
	b.Run(fmt.Sprintf("Gather/W/n=%d", n), func(b *testing.B) {
		var s DW
		for range b.N {
			s = 0
			for _, j := range idx {
				s += t[j]
			}
		}
		sinkW = s
	})
}

// cents pool: amounts of 3..10 digits at exponent -2 (0.01 .. 99,999,999.99),
// one in ten negative, and rates of 1..5 digits at exponent -4 (0.0001 .. 9.9999).
func centsPoolW(n int, seed uint64) (xs, ys, rates []DW) { return centsPoolNegW(n, seed, 10) }

func centsPoolNegW(n int, seed uint64, negDen int) (xs, ys, rates []DW) {
	r := rand.New(rand.NewPCG(seed, 2))
	amt := func() DW {
		nd := 3 + r.IntN(8)
		c := r.Int64N(pow10[nd]-pow10[nd-1]) + pow10[nd-1]
		return decimal.Compose[DW](negDen > 0 && r.IntN(negDen) == 0, 0, uint64(c), -2)
	}
	for range n {
		nd := 1 + r.IntN(5)
		c := r.Int64N(pow10[nd]-pow10[nd-1]) + pow10[nd-1]
		xs, ys = append(xs, amt()), append(ys, amt())
		rates = append(rates, decimal.Compose[DW](false, 0, uint64(c), -4))
	}
	return
}
