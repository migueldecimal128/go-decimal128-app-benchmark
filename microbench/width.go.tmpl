// d16 pool: random coefficients of 1..16 digits, exponents -4..0, so every
// value is exact at both widths (the same values on both sides).
func poolW(n int, seed uint64) (xs, ys []DW) {
	r := rand.New(rand.NewPCG(seed, 1))
	mk := func() DW {
		nd := 1 + r.IntN(16)
		c := r.Int64N(pow10[nd]-pow10[nd-1]) + pow10[nd-1]
		if r.IntN(2) == 0 {
			c = -c
		}
		e := -r.IntN(5)
		return decimal.Compose[DW](c < 0, 0, uint64(abs(c)), e)
	}
	for range n {
		xs, ys = append(xs, mk()), append(ys, mk())
	}
	return
}

